# Copy to .env: cp .env.example .env
# Run docker compose from the repo root (not from back/ or front/)
# .env is gitignored; never commit it.

# Services to run by default; override with --profile (e.g. --profile prod)
COMPOSE_PROFILES=dev

# =============================================================================
# DATABASE
# =============================================================================

# MariaDB root
MYSQL_ROOT_PASSWORD=root_password

# Backend database
MYSQL_USER=my_app_user
MYSQL_PASSWORD=my_app_password
MYSQL_DATABASE=my_app_db
MYSQL_HOST=db
MYSQL_PORT=3306

# Nextcloud database
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=nextcloud_db_password

# =============================================================================
# NEXTCLOUD
# =============================================================================

# NEXTCLOUD_URL = docker network; NEXTCLOUD_PUBLIC_URL = browser
NEXTCLOUD_URL=http://nextcloud
NEXTCLOUD_PUBLIC_URL=http://localhost:8081
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin

# Auto re-check and re-provision Nextcloud accounts
NC_LOGIN_SELF_HEAL=true

# Encryption key for stored Nextcloud app passwords (independent key in production)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NC_APP_PASSWORD_KEY=

# =============================================================================
# REDIS
# =============================================================================

# Auth state (revoked/refresh tokens). DB 1 separate from Nextcloud DB 0.
REDIS_URL=redis://redis:6379/1

# =============================================================================
# AUTH
# =============================================================================

# JWT signing key (MUST change before production)
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Grace period for replayed refresh tokens (prevents concurrent tab logout)
REFRESH_GRACE_SECONDS=10
# Reject requests if redis is down (instead of skipping revocation check)
AUTH_REDIS_STRICT=false

# =============================================================================
# BOOTSTRAP ADMIN
# =============================================================================

# Seed admin account (if ADMIN_PASSWORD unset, no admin is created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe132!
ADMIN_EMAIL=admin@assocore.local
