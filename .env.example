# Copy to .env (same directory as docker-compose.yml) and fill in.
#
# This is separate from back/.env: Docker Compose reads THIS file to resolve
# the ${VAR} substitutions inside docker-compose.yml itself (e.g. the `db`
# and `nextcloud` service definitions), while back/.env is only loaded into
# specific containers via env_file. Keep the values below in sync with
# back/.env.example — they should generally match.

# MariaDB root password (shared by the `db` container and the backend's
# init_db() bootstrap connection — must match back/.env's MYSQL_ROOT_PASSWORD)
MYSQL_ROOT_PASSWORD=root_password

# Nextcloud database
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=nextcloud_db_password

# Nextcloud admin bootstrap
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin

# Redis (used to set the backend's default REDIS_URL in docker-compose.yml)
REDIS_URL=redis://redis:6379/1
