meta {
  name: Create a folder
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/storage/folder
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "path": "bruno-demo"
  }
}

tests {
  test("answers 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  Needs Nextcloud (part of `docker compose up`). Runs as the demo member, whose Nextcloud account was created at registration.
}
