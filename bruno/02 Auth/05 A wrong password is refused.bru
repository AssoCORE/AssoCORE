meta {
  name: A wrong password is refused
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/user/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{memberUsername}}",
    "password": "Wrong@1234!"
  }
}

tests {
  test("answers 401", function () {
    expect(res.status).to.equal(401);
  });
}
