meta {
  name: Log in as the admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/user/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{adminUsername}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  bru.setVar("accessToken", res.body.access_token);
  bru.setVar("refreshToken", res.body.refresh_token);
}

tests {
  test("answers 200", function () {
    expect(res.status).to.equal(200);
  });

  test("returns a 15-minute access token and a refresh token", function () {
    expect(res.body.access_token).to.be.a("string");
    expect(res.body.refresh_token).to.be.a("string");
    // Seconds left on the token, so 899 by the time the response arrives.
    expect(res.body.expires_in).to.be.within(890, 900);
  });
}

docs {
  The admin seeded from `ADMIN_*` at startup. Its token is the collection's default auth.

  Login is rate-limited to 5 attempts per minute per client: two full runs within a minute end in 429.
}
