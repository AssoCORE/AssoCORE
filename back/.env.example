# Copy to .env and fill in. .env is gitignored.

# MariaDB Root
MYSQL_ROOT_PASSWORD=root_password

# Nextcloud Database
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=nextcloud_db_password

# App Database
MYSQL_USER=my_app_user
MYSQL_PASSWORD=my_app_password
MYSQL_DATABASE=my_app_db
MYSQL_HOST=db
MYSQL_PORT=3306

# JWT signing key — MUST be replaced with a strong random value before any deployment.
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Nextcloud API
NEXTCLOUD_URL=http://nextcloud
# URL a browser can reach — NEXTCLOUD_URL only resolves inside the docker network
NEXTCLOUD_PUBLIC_URL=http://localhost:8081
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin

# Redis (auth state — DB 1, kept off Nextcloud's DB 0)
REDIS_URL=redis://redis:6379/1

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Window in which a replayed refresh token returns its replacement instead of being treated
# as theft — stops concurrent browser tabs from logging each other out.
REFRESH_GRACE_SECONDS=10
# true = reject requests when redis is down instead of skipping the revocation check
AUTH_REDIS_STRICT=false

# Bootstrap admin — no ADMIN_PASSWORD means no admin is seeded
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@assocore.local

# Nextcloud account linking
NC_LOGIN_SELF_HEAL=true
# Encrypts stored Nextcloud app passwords. Falls back to deriving from SECRET_KEY when unset;
# set an independent value in production so a DB dump alone is useless.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NC_APP_PASSWORD_KEY=
