# AssoCORE Kubernetes Secrets Configuration
# Copy this file to .env and fill in secure values
# NEVER commit the .env file to git!

# =============================================================================
# DATABASE CREDENTIALS (MariaDB)
# =============================================================================
# Generate secure passwords using: openssl rand -base64 32

# MariaDB root password (for administrative tasks)
MARIADB_ROOT_PASSWORD=

# Database name
MARIADB_DATABASE=assocore

# Database user for application access
MARIADB_USER=assocore

# Database user password
MARIADB_PASSWORD=

# =============================================================================
# NEXTCLOUD CREDENTIALS
# =============================================================================

# NextCloud admin username
NEXTCLOUD_ADMIN_USER=admin

# NextCloud admin password
NEXTCLOUD_ADMIN_PASSWORD=

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================

# Backend database connection string will be auto-generated from above values
# Format: mysql+aiomysql://${MARIADB_USER}:${MARIADB_PASSWORD}@mariadb.assocore.svc.cluster.local:3306/${MARIADB_DATABASE}

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Generate strong passwords: openssl rand -base64 32
# 2. Keep this file secure and never commit it to version control
# 3. Use a password manager for production credentials
# 4. Rotate passwords regularly
# 5. Use Kubernetes secrets in production, not .env files
