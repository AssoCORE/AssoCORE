# GHCR Image Pull Secret Template
# DO NOT commit this file with real credentials!
# Use create-ghcr-secret.sh script instead

apiVersion: v1
kind: Secret
metadata:
  name: ghcr-secret
  namespace: assocore
type: kubernetes.io/dockerconfigjson
data:
  # Base64 encoded Docker config JSON
  # Generate with: kubectl create secret docker-registry command
  # Or use the create-ghcr-secret.sh script
  .dockerconfigjson: <base64-encoded-docker-config>

---
# Example Docker config JSON structure (before base64 encoding):
# {
#   "auths": {
#     "ghcr.io": {
#       "username": "your-github-username",
#       "password": "ghp_your_github_token",
#       "email": "your-email@example.com",
#       "auth": "base64(username:password)"
#     }
#   }
# }
